{
  "name": "aperiron",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx server/start.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/store/*.test.ts src/engine/*.test.ts src/data/*.test.ts server/*.test.ts tests/verify-*.ts",
    "test:watch": "tsx --test --watch src/store/*.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run typecheck && npm test && npm run build",
    "data:build": "tsx scripts/build-passport-index.ts",
    "travel:import": "tsx scripts/import-travel-buddy.ts",
    "assistant:openapi": "tsx scripts/generate-assistant-openapi.ts",
    "assistant:live": "tsx scripts/test-assistant-live.ts"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-simple-maps": "5.0.5",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-geo": "3.1.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
