# Keep this in an ignored .env file or your shell environment. Never expose it to Vite.
GROQ_API_KEY=
# Optional port for API-only `npm run server`; npm run dev needs no separate port.
GROQ_SERVER_PORT=8787

# Versioned assistant backend; legacy research retains its 20B model.
GROQ_ASSISTANT_MODEL=openai/gpt-oss-120b
ASSISTANT_DAILY_TOKEN_BUDGET=500000
ASSISTANT_DAILY_SEARCH_BUDGET=10
# Exact browser origins; defaults include loopback ports 5173,4173,5184,8787.
# ASSISTANT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5184
# ASSISTANT_STORE_DIR=.local/assistant
# ASSISTANT_COOKIE_SECURE=true

# Optional destination enrichment; subscribe to Basic on RapidAPI first.
TRAVEL_BUDDY_API_KEY=
# Import local trial reports with npm run travel:import to seed the cache/quota.
# For a new cache only, set the ACTUAL remaining subscription requests (default 0).
TRAVEL_BUDDY_INITIAL_REMAINING=0
TRAVEL_BUDDY_REFRESH_DAYS=7
TRAVEL_BUDDY_RETENTION_DAYS=30
TRAVEL_BUDDY_QUOTA_RESERVE=20
TRAVEL_BUDDY_CONCURRENCY=2
# Optional; default .cache/travel-buddy, ignored by Git.
# TRAVEL_BUDDY_CACHE_DIR=
